#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Z"
)


def Xform "zone"
{
    over "input" (
        prepend references = @./zone.usda@
    )
    {
        double3 xformOp:translate = (-3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    over "received" (
        prepend references = @../approvals/zone.received.usda@
    )
    {
        uniform token[] xformOpOrder = []
    }

    over "approved" (
        prepend references = @../approvals/zone.approved.usda@
    )
    {
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
