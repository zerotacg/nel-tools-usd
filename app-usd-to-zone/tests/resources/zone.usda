#usda 1.0
(
    defaultPrim = "root/zone"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "root"
{
    def Xform "zone"
    {
      def NurbsPatch "hill"
      {
          uniform token orientation = "leftHanded"
          int uOrder = 4
          int vOrder = 4

          int uVertexCount = 4
          int vVertexCount = 4

          double[] uKnots = [0, 0, 0, 0, 1, 1, 1, 1]
          double[] vKnots = [0, 0, 0, 0, 1, 1, 1, 1]

          double2 uRange = (0, 1)
          double2 vRange = (0, 1)

          uniform token uForm = "open"
          uniform token vForm = "open"

          point3f[] points = [
              (0, 0, 0), (0.5, 0, 0), (1, 0, 0), (1.5, 0, 0),
              (0, 0, 1), (0.5, 1, 1), (1, 1, 1), (1.5, 0, 1),
              (0, 0, 2), (0.5, 1, 2), (1, 1, 2), (1.5, 0, 2),
              (0, 0, 3), (0.5, 0, 3), (1, 0, 3), (1.5, 0, 3),
          ]

          float3[] extent = [(0, 0, 0), (1.5, 1, 3)]
      }
      def NurbsPatch "valley"
      {
          uniform token orientation = "leftHanded"
          int uOrder = 4
          int vOrder = 4

          int uVertexCount = 4
          int vVertexCount = 4

          double[] uKnots = [0, 0, 0, 0, 1, 1, 1, 1]
          double[] vKnots = [0, 0, 0, 0, 1, 1, 1, 1]

          double2 uRange = (0, 1)
          double2 vRange = (0, 1)

          uniform token uForm = "open"
          uniform token vForm = "open"

          point3f[] points = [
              (1.5, 0, 0), (2, 0, 0), (2.5, 0, 0), (3, 0, 0),
              (1.5, 0, 1), (2,-1, 1), (2.5,-1, 1), (3, 0, 1),
              (1.5, 0, 2), (2,-1, 2), (2.5,-1, 2), (3, 0, 2),
              (1.5, 0, 3), (2, 0, 3), (2.5, 0, 3), (3, 0, 3),
          ]

          float3[] extent = [(1.5, -1, 0), (3, 0, 3)]
      }
    }
}
