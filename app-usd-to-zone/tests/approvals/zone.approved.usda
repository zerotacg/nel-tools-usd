#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "root"
{
    def Xform "zone"
    {
        def NurbsPatch "patch_0" (
            customData = {
                dictionary nel = {
                    uchar orderS = 2
                    uchar orderT = 2
                }
            }
        )
        {
            uniform token orientation = "leftHanded"
            point3f[] points = [(0, 0, 0), (0.5, 0, 0), (1, 0, 0), (1.5, 0, 0), (0, 0, 1), (0.5, 1, 1), (1, 1, 1), (1.5, 0, 1), (0, 0, 2), (0.5, 1, 2), (1, 1, 2), (1.5, 0, 2), (0, 0, 3), (0.5, 0, 3), (1, 0, 3), (1.5, 0, 3)]
            uniform token uForm = "open"
            double[] uKnots = [0, 0, 0, 0, 1, 1, 1, 1]
            int uOrder = 4
            double2 uRange = (0, 1)
            int uVertexCount = 4
            uniform token vForm = "open"
            double[] vKnots = [0, 0, 0, 0, 1, 1, 1, 1]
            int vOrder = 4
            double2 vRange = (0, 1)
            int vVertexCount = 4
        }

        def NurbsPatch "patch_1" (
            customData = {
                dictionary nel = {
                    uchar orderS = 2
                    uchar orderT = 2
                }
            }
        )
        {
            uniform token orientation = "leftHanded"
            point3f[] points = [(1.5, 0, 0), (2, 0, 0), (2.5, 0, 0), (3, 0, 0), (1.5, 0, 1), (2, -1, 1), (2.5, -1, 1), (3, 0, 1), (1.5, 0, 2), (2, -1, 2), (2.5, -1, 2), (3, 0, 2), (1.5, 0, 3), (2, 0, 3), (2.5, 0, 3), (3, 0, 3)]
            uniform token uForm = "open"
            double[] uKnots = [0, 0, 0, 0, 1, 1, 1, 1]
            int uOrder = 4
            double2 uRange = (0, 1)
            int uVertexCount = 4
            uniform token vForm = "open"
            double[] vKnots = [0, 0, 0, 0, 1, 1, 1, 1]
            int vOrder = 4
            double2 vRange = (0, 1)
            int vVertexCount = 4
        }
    }
}

