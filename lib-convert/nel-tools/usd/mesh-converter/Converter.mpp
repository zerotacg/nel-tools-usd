module;
#include <pxr/usd/usd/stage.h>
#include <nel/3d/mesh.h>

export module nel_tools.usd.mesh_converter.Converter;

export class Converter
{
public:
    virtual ~Converter() = default;

    const struct Settings
    {
        const bool convertToLowerCase;
        const bool replaceExtension;
        const std::string extension;
        const std::string prefix;
    }& settings;

    virtual void run() = 0;

    static void convert(const Settings& settings, pxr::UsdStageRefPtr& target, NL3D::IShape* shape);

protected:
    explicit Converter(const Settings& settings, pxr::UsdStageRefPtr& target)
        : settings(settings), stage(target)
    {
    }

    pxr::UsdStageRefPtr& stage;
};
