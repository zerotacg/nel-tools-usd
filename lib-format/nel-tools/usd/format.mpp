module;
#include <string_view>
#include <fmt/format.h>
#include <nel/3d/texture.h>

export module nel_tools.usd.format;
export template <> struct fmt::formatter<NL3D::ITexture::TUploadFormat>: formatter<std::string_view> {

    auto format(NL3D::ITexture::TUploadFormat source, format_context& ctx) const
      -> format_context::iterator
    {
        string_view name = "unknown";
        switch (source)
        {
            // clang-format off
        case NL3D::ITexture::Auto:              name = "Auto"; break;
        case NL3D::ITexture::RGBA8888:          name = "RGBA8888"; break;
        case NL3D::ITexture::RGBA4444:          name = "RGBA4444"; break;
        case NL3D::ITexture::RGBA5551:          name = "RGBA5551"; break;
        case NL3D::ITexture::RGB888:            name = "RGB888"; break;
        case NL3D::ITexture::RGB565:            name = "RGB565"; break;
        case NL3D::ITexture::DXTC1:             name = "DXTC1"; break;
        case NL3D::ITexture::DXTC1Alpha:        name = "DXTC1Alpha"; break;
        case NL3D::ITexture::DXTC3:             name = "DXTC3"; break;
        case NL3D::ITexture::DXTC5:             name = "DXTC5"; break;
        case NL3D::ITexture::Luminance:         name = "Luminance"; break;
        case NL3D::ITexture::Alpha:             name = "Alpha"; break;
        case NL3D::ITexture::AlphaLuminance:    name = "AlphaLuminance"; break;
        case NL3D::ITexture::DsDt:              name = "DsDt"; break;
        case NL3D::ITexture::UploadFormatCount: name = "UploadFormatCount"; break;
            // clang-format on
        }
        return formatter<string_view>::format(name, ctx);
    }
};
