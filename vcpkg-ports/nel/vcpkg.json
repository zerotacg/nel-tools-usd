{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "nel",
  "version": "4.1.0.0",
  "description": "Ryzom Core is the open-source project related to Ryzom Game.",
  "homepage": "https://github.com/ryzom/ryzomcore",
  "license": "AGPL-3.0-only",
  "dependencies": [
    {
      "name": "libxml2",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "zlib",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
  ],
  "features": {
    "3d": {
      "description": [],
      "dependencies": [
        {
          "name": "freetype",
          "default-features": false,
          "features": [
            "error-strings"
          ]
        }
      ]
    }
  }
}
