{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "nel",
  "version": "4.1.0.0",
  "description": "Ryzom Core is the open-source project related to Ryzom Game.",
  "homepage": "https://github.com/ryzom/ryzomcore",
  "license": "AGPL-3.0-only",
  "dependencies": [
    "giflib",
    "libpng",
    "libjpeg-turbo",
    {
      "name": "libxml2",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "openssl",
    "zlib",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
  ],
  "features": {
    "3d": {
      "description": [],
      "dependencies": [
        {
          "name": "directxsdk",
          "platform": "windows"
        },
        {
          "name": "freetype",
          "default-features": false,
          "features": [
            "error-strings"
          ]
        },
        "opengl"
      ]
    },
    "gui": {
      "description": [],
      "dependencies": [
        "curl",
        "lua",
        "luabind"
      ]
    },
    "sound": {
      "description": [],
      "dependencies": [
        "libogg",
        "libvorbis",
        "openal-soft"
      ]
    },
    "web": {
      "description": [],
      "dependencies": [
        "curl",
        "lua",
        "luabind"
      ]
    },
    "msquic": {
      "description": [],
      "dependencies": [
        "msquic"
      ]
    }
  }
}
