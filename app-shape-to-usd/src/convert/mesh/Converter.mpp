module;
#include <nel/3d/mesh.h>
#include <pxr/usd/usd/stage.h>
#include <pxr/usd/usdGeom/xform.h>

export module nel_tools.usd.shape_to_usd.convert.mesh.Converter;
import nel_tools.usd.shape_to_usd.convert.material.TextureSettings;

export namespace nel_tools::usd::shape_to_usd::convert::mesh
{
    class Converter
    {
    public:
        virtual ~Converter() = default;

        virtual void run() = 0;

        static void convert(const material::TextureSettings& settings, pxr::UsdStageRefPtr& target,
                            NL3D::IShape* shape);

    protected:
        explicit Converter(const material::TextureSettings& settings, pxr::UsdStageRefPtr& stage,
                           pxr::UsdGeomXform& target)
            : settings(settings), stage(stage), modelRoot(target)
        {
        }

        const material::TextureSettings& settings;
        pxr::UsdStageRefPtr& stage;
        pxr::UsdGeomXform& modelRoot;
    };
}
