module;
#include <nel/3d/mesh_mrm_skinned.h>
#include <pxr/base/vt/array.h>
#include <pxr/usd/usd/common.h>
#include <pxr/usd/usdGeom/xform.h>

export module nel_tools.usd.shape_to_usd.convert.mesh.ConverterCMeshMRMSkinned;
import nel_tools.usd.shape_to_usd.convert.mesh.Converter;
import nel_tools.usd.shape_to_usd.convert.material.TextureSettings;

export namespace nel_tools::usd::shape_to_usd::convert::mesh
{
    class ConverterCMeshMRMSkinned : public Converter
    {
    public:
        explicit ConverterCMeshMRMSkinned(const material::TextureSettings& settings, pxr::UsdStageRefPtr& stage,
                                pxr::UsdGeomXform& target,
                                NL3D::CMeshMRMSkinned* source)
            : Converter(settings, stage, target), mesh(source), lodId(mesh->getNbLod() - 1)
        {
        }

        void run() override;

    protected:
        pxr::VtArray<int> convertIndices() const;
        pxr::VtArray<int> convertFaceCount(pxr::VtArray<int>& source) const;
        pxr::VtArray<int> convertFaceIndices(const NL3D::CIndexBuffer& source, int offset = 0) const;
        void subsets();
        size_t subset(uint renderPass, int faceOffset);
        void materials();

    private:
        NL3D::CMeshMRMSkinned* const mesh;

        const uint lodId;
    };
}
