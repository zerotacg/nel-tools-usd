module;
#include <string>
#include <vector>

#include <nel/misc/cmd_args.h>

export module nel_tools.usd.shape_to_usd.Settings;
import nel_tools.usd.arguments;
import nel_tools.usd.convert.mesh.Converter;

export namespace nel_tools::usd::shape_to_usd
{
    using namespace convert::mesh;

    struct Settings
    {
        const std::string input;
        const std::string output;

        const Converter::Settings texture;

        static Settings from(const NLMISC::CCmdArgs& args)
        {
            return {
                .input = args.getAdditionalArg("input").front(),
                .output = args.getAdditionalArg("output").front(),
                .texture = {
                    .convertToLowerCase = args.haveLongArg("texture-file-to-lower-case"),
                    .replaceExtension = args.haveLongArg("texture-file-replace-extension"),
                    .extension = arguments::getFirstLongArg(args, "texture-file-replace-extension"),
                    .prefix = arguments::getFirstLongArg(args, "texture-file-prefix")
                }
            };
        }

        static std::string firstOrEmpty(const std::vector<std::string>& values)
        {
            if (values.empty())
            {
                return {};
            }

            return values.front();
        }
    };
}
