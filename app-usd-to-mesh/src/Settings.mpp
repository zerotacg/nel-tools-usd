module;
#include <optional>
#include <string>

#include <nel/misc/cmd_args.h>

export module nel_tools.usd.usd_to_mesh.Settings;
import nel_tools.usd.arguments;
import nel_tools.usd.usd_to_mesh.convert.Converter;
import nel_tools.usd.usd_to_mesh.convert.material.TextureSettings;

export namespace nel_tools::usd::usd_to_mesh
{
    using namespace convert;

    struct Settings
    {
        const std::string input;
        const std::string output;
        const std::optional<std::string> outputXml;

        const material::TextureSettings texture;

        static Settings from(const NLMISC::CCmdArgs& args)
        {
            return {
                .input = arguments::getFirstAdditionalArg(args, "input"),
                .output = arguments::getFirstAdditionalArg(args, "output"),
                .outputXml = arguments::optional(args, "output-xml"),
                .texture = {
                    .removeTextureFilePath = args.haveLongArg("texture-file-remove-path")
                }
            };
        }
    };
}
