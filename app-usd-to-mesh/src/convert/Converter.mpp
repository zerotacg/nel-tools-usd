module;
#include <memory>

#include <nel/3d/shape.h>
#include <pxr/usd/usd/stage.h>

export module nel_tools.usd.usd_to_mesh.convert.Converter;

export namespace nel_tools::usd::usd_to_mesh::convert
{
    class Converter
    {
    public:
        const struct Settings
        {
        }& settings;

        explicit Converter(const Settings& settings, const pxr::UsdStageRefPtr& source)
            : settings(settings), stage(source)
        {
        }

        auto run() -> std::unique_ptr<NL3D::IShape>;

    private:
        const pxr::UsdStageRefPtr& stage;

        const struct
        {
            const pxr::TfToken root = pxr::TfToken("root");
            const pxr::TfToken st = pxr::TfToken("primvars:st");
            const pxr::TfToken stIndices = pxr::TfToken("st:indices");
            const pxr::TfToken result = pxr::TfToken("result");
            const pxr::TfToken varname = pxr::TfToken("varname");
            const pxr::TfToken frame_stPrimvarName = pxr::TfToken("frame:stPrimvarName");
        } Tokens;
    };
}
