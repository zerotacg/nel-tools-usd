export module nel_tools.usd.usd_to_mesh.convert.Converter;

export namespace nel_tools::usd::usd_to_mesh::convert
{
    class Converter
    {
    public:
        const struct Settings
        {
        }& settings;

        explicit Converter(const Settings& settings, const pxr::UsdStageRefPtr& source)
