#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "root" (
    kind = "component"
    prepend variantSets = "textureSet"
)
{
    float3 xformOp:rotateXYZ = (0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def Mesh "model" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 0
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </root/_materials/material_0_MAT>
        normal3f[] normals = [(0, -1, 0), (0, -1, 0), (0, -1, 0)] (
            interpolation = "vertex"
        )
        point3f[] points = [(0, 0, 0), (2, 0, 0), (1, 0, 1)]
        texCoord2f[] primvars:st = [(0, 0), (1, 0), (0.5, 0.5)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
        uniform token subsetFamily:materialBind:familyType = "nonOverlapping"
    }

    def Scope "_materials"
    {
        def Material "material_0_MAT"
        {
            token outputs:surface.connect = </root/_materials/material_0_MAT/PBRShader.outputs:surface>

            def Shader "PBRShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0, 1)
                color3f inputs:diffuseColor.connect = </root/_materials/material_0_MAT/texture_0.outputs:rgb>
                float inputs:opacity.connect = </root/_materials/material_0_MAT/texture_0.outputs:a>
                float inputs:roughness = 0.9
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "texture_0"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @test.png@
                token inputs:magFilter = "linear"
                token inputs:minFilter = "linearMipmapLinear"
                float2 inputs:st.connect = </root/_materials/material_0_MAT/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:a
                float3 outputs:rgb
            }
        }
    }
}

