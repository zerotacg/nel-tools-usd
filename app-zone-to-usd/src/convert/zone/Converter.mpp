module;
#include <span>
#include <nel/3d/zone.h>
#include <pxr/usd/usd/stage.h>
#include <pxr/usd/usdGeom/nurbsPatch.h>
#include <pxr/usd/usdGeom/xform.h>

export module nel_tools.usd.zone_to_usd.convert.zone.Converter;

export namespace nel_tools::usd::zone_to_usd::convert::zone
{
    class Converter
    {
    public:
        explicit Converter(pxr::UsdStageRefPtr& stage, pxr::UsdGeomXform& target, const NL3D::CZone* source)
            : stage(stage), zoneRoot(target), zone(source)
        {
        }

        virtual ~Converter() = default;

        virtual void run();

        pxr::VtArray<pxr::GfVec3f> value(const std::span<NLMISC::CVector>& source);
        void convert(pxr::UsdGeomNurbsPatch& target, const NL3D::CPatch& source);
        void convert(pxr::UsdGeomNurbsPatch& target, const NL3D::CBezierPatch& source);

        static void convert(pxr::UsdStageRefPtr& target, const NL3D::CZone* source);

    protected:
        pxr::UsdStageRefPtr& stage;
        pxr::UsdGeomXform& zoneRoot;
        const NL3D::CZone* zone;
    };
}
